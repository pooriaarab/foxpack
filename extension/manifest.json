{
  "manifest_version": 3,
  "name": "foxpack",
  "version": "0.0.0",
  "description": "Bring your AI memory home: import ChatGPT, Claude and Gemini exports into a local store.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxpack@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxpack",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  }
}
